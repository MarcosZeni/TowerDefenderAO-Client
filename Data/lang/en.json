  // ---------------------------------------------------------------------------
  //  English.
  //
  //  ⚠ Las claves son las mismas que en es.json y NO se traducen: salen de la
  //  key de perks.json y de los nombres de los enums. Lo único que cambia es el
  //  valor.
  //
  //  Falta una clave acá -> se cae a es.json. Falta en los dos -> se muestra la
  //  clave cruda, que es feo a propósito: un texto sin traducir tiene que verse.
  //
  //  ⚠ No entra al hash de /run/start: traducir no cambia la simulación.
  //
  //  Los nombres de los hechizos siguen la nomenclatura de Argentum Online en
  //  inglés donde existe; donde no, se elige el más corto que se entienda.
  // ---------------------------------------------------------------------------
  "language": "English",
  "code": "en",

  "strings": {
    // --- Formato de números -------------------------------------------------
