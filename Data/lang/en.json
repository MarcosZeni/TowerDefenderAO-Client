    // ⚠ El separador decimal del idioma: en inglés es el punto. Adentro de la
    // simulación no hay coma flotante; esto es solo cómo se escribe la fracción
    // del daño (centésimas de punto) y del alcance (milésimas de celda).
    "ui.format.decimal": ".",

    // Thousands separator. The mockup writes «12,450» and «1,250 / 1,250».
    "ui.format.miles": ",",
