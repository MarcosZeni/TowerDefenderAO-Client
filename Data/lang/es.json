    // --- Qué hace cada efecto, en una línea --------------------------------
    //
    //  ⚠ Existe porque el nombre no dice nada. «Sobrepenetración 40%» es un
    //  cartel que no se puede leer sin abrir el código: ni qué hace, ni sobre
    //  qué es ese 40. Un Oro es una de las ocho oportunidades de toda la
    //  corrida, y elegirlo a ciegas era la peor decisión que ofrecía el juego.
    //
    //  Tres reemplazos, todos opcionales por texto:
    //    {m}  «magnitude» del perk
    //    {b}  «magnitudeB», el segundo número de los Únicos y de los que
    //         pegan distinto al primero y al segundo
    //    {n}  el número que NO está en perks.json y vive en combate.json:
    //         cada cuántos golpes dispara, o el umbral de vida del condicional
    //
    //  Se escriben en minúscula y sin punto final: el cartel los muestra
    //  debajo del nombre, que ya es el título.
    "effect.Damage.text": "+{m}% de daño",
    "effect.Cadence.text": "+{m}% de cadencia: pega más seguido",
    "effect.Range.text": "+{m}% de alcance",
    "effect.Ricochet.text": "el golpe rebota a otro enemigo cercano, {m}% del daño",
    "effect.Splash.text": "daña también a los que están cerca, {m}% del golpe",
    "effect.Slow.text": "deja al golpeado {m}% más lento un rato",
    "effect.CriticalHit.text": "cada {n} golpes, uno suma un impacto extra del {m}%",
    "effect.Poison.text": "envenena por el {m}% del golpe, repartido en el tiempo",
    "effect.Chain.text": "salta a otros dos enemigos: {m}% y {b}% del golpe",
    "effect.Burn.text": "quema al objetivo ({m}% del golpe) y a los cercanos ({b}%)",
    "effect.Weaken.text": "el golpeado le hace {m}% menos daño a la Torre",
    "effect.Sunder.text": "cada {n} golpes deja al objetivo +{m}% vulnerable para todos",
    "effect.Focus.text": "+{m}% de daño por cada golpe seguido al mismo objetivo",
    "effect.HuntMark.text": "lo marca: las OTRAS clases le pegan +{m}%",
    "effect.Bleed.text": "sangrado por el {m}% del golpe, repartido en el tiempo",
    "effect.Root.text": "cada {n} golpes lo deja inmóvil un instante",
    "effect.Seismic.text": "cada {n} golpes lo empuja media celda hacia atrás",
    "effect.Inspire.text": "cada {n} ataques, +{m}% de cadencia a los aliados cercanos",
    "effect.Loot.text": "si muere marcado, suelta +{m}% de oro",
    "effect.Opportunist.text": "+{m}% de daño por debajo del {n}% de vida",
    "effect.ThresholdGuard.text": "+{m}% de daño a los que ya están mordiendo la Torre",
    "effect.ArcaneEcho.text": "cada {n} golpes, un eco diferido por el {m}% del daño",
