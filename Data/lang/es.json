  // ---------------------------------------------------------------------------
  //  Español. El idioma de referencia.
  //
  //  ⚠ ESTE ARCHIVO NO ENTRA AL HASH DE /run/start, y es la única carpeta de
  //  Data\ que no entra. Traducir no cambia la simulación: un jugador en inglés
  //  y uno en español juegan exactamente la misma corrida con la misma seed. Si
  //  entrara al hash, cambiar una coma de un texto invalidaría el ranking.
  //
  //  ⚠ ES EL ARCHIVO DE REFERENCIA. Cuando falta una clave en otro idioma, se
  //  cae a este; cuando falta acá, se muestra la clave cruda —«perk.filo.name»—
  //  que es feo a propósito: un texto faltante tiene que verse.
  //
  //  Las claves salen de los datos y NO SE TRADUCEN: «perk.<key>.name» usa la
  //  key de perks.json, «class.<Clase>.name» el nombre del enum, y
  //  «ability.<Habilidad>.name» el de los pools de generador-armas.json.
  //
  //  El {m} de los textos de habilidad lo reemplaza la magnitud del arma.
  // ---------------------------------------------------------------------------
  "language": "Español",
  "code": "es",

  "strings": {
    // --- Formato de números -------------------------------------------------
    //
    // ⚠ El separador decimal del idioma. Adentro de la simulación NO hay coma
    // flotante: el daño vive en centésimas de punto y el alcance en milésimas de
    // celda (propuesta V2, anomalía P0). Esto es solo cómo se escribe esa
    // fracción cuando se la muestra.
    "ui.format.decimal": ",",

    // El separador de miles. El diseño escribe «12.450» y «1.250 / 1.250»: sin
    // esto, los cinco dígitos del oro de una corrida larga se leen de a uno.
    "ui.format.miles": ".",
    // --- Los carteles de los iconos -----------------------------------------
    //
    // ⚠ Existen porque los iconos reemplazaron palabras. Cambiar «daño 7» por una
    // espada y un 7 alinea las columnas y saca el largo del texto de la ecuación,
    // pero le pide al jugador que YA SEPA qué significa cada dibujo: un reloj
    // puede ser cadencia, duración o tiempo restante. El cartel es lo que hace
    // que el icono no sea un acertijo la primera vez.
    //
    // La clave sale del nombre del enum UiStyle.Stat, igual que los atajos.
    "ui.stat.Damage": "daño por golpe",
    "ui.stat.Range": "alcance, en celdas",
    "ui.stat.Cadence": "cada cuántos ticks dispara — menos es más rápido",

