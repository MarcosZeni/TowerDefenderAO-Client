{
  // ---------------------------------------------------------------------------
  //  Los planos de fusión: dos perks de Oro se consumen y sale un Único.
  //
  //  ⚠ EL ÚNICO OCUPA UN SOLO SLOT. El slot liberado es la mitad del premio.
  //
  //  El plano se compra UNA VEZ, con la billetera, desde el menú principal, y
  //  queda aprendido para siempre en esa cuenta. Junto con la billetera, es la
  //  ÚNICA PROGRESIÓN PERMANENTE DEL PROYECTO: todo lo demás muere con la corrida.
  //
  //  ⚠ LA LISTA ES FINITA, Y ESA ES LA REGLA. Es la condición que hace tolerable
  //  la ventaja del veterano: tiene techo. Por eso no se agrega equipo permanente
  //  ni nada que escale sin fin. Agregar planos sin freno rompe esa promesa.
  //
  //  ⚠ Entra al hash de /run/start. Tocar esto es TEMPORADA NUEVA.
  // ---------------------------------------------------------------------------
  "version": 1,

  // Se referencian por la "key" de perks.json y NO por id: un id pegado a mano
  // quedaría apuntando a otro perk en cuanto alguien agregue uno, y el síntoma
  // sería una fusión que produce algo que no es. Tampoco por nombre, que ahora
  // vive en los archivos de idioma y cambia con el idioma.
  //
  // El nombre del plano que ve el jugador es el del único que produce:
  // «perk.<key>.name» en Datos\lang\.
  //
  // "goldA" y "goldB" tienen que ser de tier gold; "key" tiene que ser un tier
  // unique. El orden de goldA/goldB no importa al fusionar — el validador
  // (--validar) chequea las tres cosas.
  //
  // "initial": true = se sabe sin comprar nada.
  // ⚠ Tiene que haber AL MENOS UNA inicial. Sin eso un jugador nuevo nunca ve un
  // Único y la fusión —la salida de los Oro repetidos— le resulta invisible
  // hasta que gasta oro en algo que no entiende para qué sirve.
  "blueprints": [
    { "key": "perforacion",    "goldA": "ricochet",        "goldB": "golpeCertero",      "initial": true  },
    { "key": "ondaDeFrio",     "goldA": "escarcha",        "goldB": "ondaExpansiva",     "initial": false },
    { "key": "iraDeDios",      "goldA": "ondaExpansiva",   "goldB": "misilMagico",       "initial": false },
    { "key": "apocalipsis",    "goldA": "ricochet",        "goldB": "envenenar",         "initial": false },
    { "key": "terribleHambre", "goldA": "envenenar",       "goldB": "escarcha",          "initial": false },
    { "key": "tormentaDivina", "goldA": "tormentaDeFuego", "goldB": "dardoMagico",       "initial": false },
    { "key": "ceguera",        "goldA": "torpeza",         "goldB": "descargaElectrica", "initial": false },
    { "key": "fuerza",         "goldA": "golpeCertero",    "goldB": "ondaExpansiva",     "initial": false },
    { "key": "invisibilidad",  "goldA": "torpeza",         "goldB": "golpeCertero",      "initial": false }
  ]
}
