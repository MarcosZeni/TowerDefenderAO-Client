{
  // ---------------------------------------------------------------------------
  //  Los números del tick: qué hace cada comportamiento cuando pega.
  //
  //  Esto es lo que antes vivía como literales adentro de Partida.cs. Son las
  //  reglas más difíciles de balancear del juego porque no se ven en ninguna
  //  tabla: el jugador ve "Ricochet 55%", no ve que el salto tiene un límite de
  //  dos celdas de ruta.
  //
  //  ⚠ Entra al hash de /run/start. Tocar esto es TEMPORADA NUEVA del ranking.
  //
  //  ⚠ TODO ACÁ ES ENTERO Y ASÍ SE QUEDA. Dentro de la simulación están
  //  prohibidos float, double, System.Random, Math.Sin/Cos/Atan2/Pow/Log. Un
  //  número con coma en este archivo es un bug, no una precisión.
  // ---------------------------------------------------------------------------
  "version": 1,

  // --- El enemigo ------------------------------------------------------------
  //
  // El daño de un enemigo es el PROMEDIO de danoMin y danoMax, no una tirada.
  // Es determinismo barato: una tirada por golpe consumiría RNG en un punto que
  // depende de cuántos enemigos estén vivos, y eso corre toda la secuencia.
  "enemigo": {
    "divisorPromedioDano": 2,
    "danoMinimo": 1
  },

  // --- Ralentización ---------------------------------------------------------
  //
  // ⚠ TEMPORAL Y NO APILA (propuesta V2). Antes el slow restaba directo en el
  // buff de velocidad del NPC y era PERMANENTE: dos fuentes dejaban a toda la
  // oleada al 20% de velocidad para el resto de la corrida.
  //
  // Ahora: prevalece la potencia más fuerte, cada aplicación refresca la
  // duración, y la fase 3 del tick lo vence. El techo existe porque un enemigo
  // parado no es un enemigo lento: es un enemigo muerto en cámara lenta.
  "ralentizar": {
    "topePorciento": 60,
    "duracionTicks": 90
  },

  // --- Comportamientos de perk (Oro y Único) --------------------------------
  //
  // ⚠ SOLO SE APLICA UN COMPORTAMIENTO: el del perk de tier más alto equipado.
  // Y si el arma tiene habilidad, el comportamiento del perk queda en Ninguno —
  // el arma pisa al perk. Es la regla que la propuesta V2 quiere hacer visible
  // con una ranura "Rasgo", porque hoy un Oro raro puede quedar mudo sin que el
  // jugador se entere.
  //
  // "rebotes" = saltos EXTRA además del golpe directo.
  // "maxSecundarios" = cuántos enemigos además del objetivo alcanza el splash.
  //
  // ⚠ Ricochet es LOCAL (propuesta V2): cada salto tiene que caer a
  // ventanaSaltoRicochetCeldas o menos del objetivo ANTERIOR, medido sobre la
  // ruta. Antes rebotaba al otro lado del mapa.
  //
  // ⚠ El radio del splash se mide SOBRE LA RUTA, en celdas de recorrido, no en
  // distancia euclídea. Un enemigo no tiene (x, y): tiene una DistanciaRecorrida.
  "comportamientos": {
    "ventanaSaltoRicochetCeldas": 2,
    "radioSplashCeldas": 2,

    "rebotesRicochet": 1,
    "rebotesPerforacion": 2,
    "rebotesApocalipsis": 3,

    "maxSecundariosSplashOro": 4,
    "maxSecundariosOndaDeFrio": 6,
    "maxSecundariosIraDeDiosYTormentaDivina": 6,

    // Terrible Hambre envenena y además ralentiza, con esta potencia fija.
    "slowTerribleHambre": 25,

    // ⚠ Penetrante se divide por esto MIENTRAS NO EXISTA LA DEFENSA. Hoy no hay
    // nada que penetrar, así que el perk es daño extra a cuarto de magnitud. La
    // propuesta V2 quiere reemplazarlo por Quebranto (vulnerabilidad) justamente
    // por esto.
    "divisorPenetrante": 4,

    // Cada cuántos golpes DE ESE DEFENSOR cae el crítico.
    //
    // ⚠ CONTADOR POR DEFENSOR, no Tick % 7 global (propuesta V2). Con el global
    // criticaban todos juntos en el mismo tick, y un defensor cuya cadencia
    // fuera múltiplo de 7 criticaba siempre o nunca según la fase.
    "golpesPorCritico": 7
  },

  // --- Habilidades de arma ---------------------------------------------------
  //
  // Los topes que no son la magnitud. La magnitud sale de generador-armas.json.
  "habilidadesArma": {
    "maxSecundariosSplash": 4,
    "rebotesRebote": 1,
    "maxSecundariosCadena": 5,

    // ⚠ Techo del bonus ACUMULADO por muertes de la oleada, no por muerte. Se
    // reinicia al lanzar cada oleada: el techo real tiene que ser cuánto se
    // puede matar de una vez, no cuánto se lleva matado en cien oleadas.
    "topeBonusSed": 100,

    // Francotirador y Carnicero escalan con qué porción del alcance usó el
    // disparo. Son enteros en centésimas: 100 = el alcance entero.
    "topePorcionAlcance": 100,
    "escalaPorcionAlcance": 100,

    // ⚠ Ejecutar: umbral de vida por debajo del cual mata de un golpe.
    //
    // El umbral efectivo es min(magnitud del arma, el de acá) — o sea, estos son
    // TECHOS, no valores. Los jefes tienen el suyo mucho más bajo porque un jefe
    // que muere por un umbral no es un jefe, y EL JEFE FINAL ES INMUNE: matarlo
    // es cómo se gana la corrida, y ganar por Ejecutar sería ganar por el drop y
    // no por la partida.
    "umbralEjecutarTropa": 20,
    "umbralEjecutarJefe": 5,
    "jefeFinalInmuneAEjecutar": true,

    // ⚠ Un proc por CLASE cada tantos ticks, no por defensor. Sin esto, diez
    // defensores de la misma clase con un arma de Vampirismo curaban la Torre
    // más rápido de lo que una oleada entera podía bajarla.
    "cooldownVampirismoTicks": 30,

    // Cuánto dura la marca de oro extra de Codicia. Se marca al golpear y se
    // cobra en la fase de muertes, cuando se sabe si el golpe mató —cobrarlo al
    // golpear daría oro por pegarle a algo que sobrevive.
    //
    // ⚠ Antes la marca duraba PARA SIEMPRE: un solo golpe convertía a un tanque
    // en alcancía aunque lo terminara matando otro, minutos después.
    "duracionMarcaCodiciaTicks": 60
  }
}
