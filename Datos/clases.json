{
  // ---------------------------------------------------------------------------
  //  Las nueve clases de combate de Argentum Online.
  //
  //  ⚠ NO existe "arquero": el que tira flechas es el Cazador.
  //  ⚠ Las trabajadoras quedan afuera —leñador, minero, pescador, herrero,
  //    carpintero, sastre—: no pelean, y este juego es solo pelear.
  //
  //  REGLA DEL DAÑO: más alcance, menos golpe. Un melee ve pasar a cada bicho
  //  una sola vez por delante; uno de rango cubre media ruta y le pega a todo lo
  //  que camina por ella. Si encima pegara igual, el de rango jugaría solo.
  //
  //  ⚠ Este archivo es ENTRADA de la simulación y entra al hash de /run/start.
  //  Cambiar un número acá vuelve irreplicables las corridas viejas: es una
  //  TEMPORADA NUEVA del ranking. Ver DATOS.md §7.
  // ---------------------------------------------------------------------------
  "version": 1,

  // Puntos porcentuales de daño que suma cada nivel por encima del 1.
  //
  // ⚠ Con daño base entero y chico, el truncamiento se come varios niveles:
  // un cazador de 4 no sube nada en los niveles 2, 3 y 4 (4 × 1,08 = 4,32 → 4).
  // Es la anomalía P0 de la propuesta V2 y se arregla escalando el daño
  // internamente ×100, no subiendo este número.
  "extraDamagePerLevel": 8,

  // Nivel máximo y, a la vez, slots de perk por clase: cada nivel abre uno.
  "perkSlotsPerClass": 6,

  // Alcance en CELDAS. La simulación lo compara al cuadrado porque no calcula
  // raíces (JUGABILIDAD.md §4.2).
  //
  // ⚠ alcance 1 NO cubre las diagonales: una celda en diagonal queda a
  // √2 ≈ 1,41 y no entra. Por eso el mínimo del roster es 2.
  //
  // "support": pega poco a propósito, su valor está en lo que le hace al resto
  // del equipo. Se usa para garantizar que la elección inicial traiga al menos
  // una clase capaz de sostener sola una defensa.
  "classes": [
    // DPS = dano × 30 / cadencia.
    { "class": "Mage",     "cost": 100, "damage": 10, "range": 4, "cadence": 30, "support": false },
    { "class": "Cleric",  "cost":  80, "damage":  7, "range": 3, "cadence": 24, "support": true  },
    { "class": "Warrior", "cost":  60, "damage":  7, "range": 2, "cadence": 18, "support": false },
    { "class": "Assassin",  "cost":  90, "damage": 12, "range": 2, "cadence": 21, "support": false },
    { "class": "Thief",   "cost":  50, "damage":  5, "range": 2, "cadence": 18, "support": false },
    { "class": "Bard",    "cost":  70, "damage":  6, "range": 3, "cadence": 21, "support": true  },
    { "class": "Druid",   "cost":  85, "damage":  8, "range": 3, "cadence": 27, "support": true  },
    { "class": "Paladin",  "cost":  95, "damage": 13, "range": 2, "cadence": 24, "support": false },
    { "class": "Hunter",  "cost":  75, "damage":  4, "range": 6, "cadence": 21, "support": false }
  ]
}
