    // --- What each effect does, in one line --------------------------------
    //  {m} = magnitude, {b} = magnitudeB, {n} = the number that lives in
    //  combate.json (every how many hits, or the health threshold).
    "effect.Damage.text": "+{m}% damage",
    "effect.Cadence.text": "+{m}% attack speed",
    "effect.Range.text": "+{m}% range",
    "effect.Ricochet.text": "the shot bounces to a nearby enemy for {m}% damage",
    "effect.Splash.text": "also hits nearby enemies for {m}% of the blow",
    "effect.Slow.text": "leaves the target {m}% slower for a while",
    "effect.CriticalHit.text": "every {n} hits, one adds an extra {m}% strike",
    "effect.Poison.text": "poisons for {m}% of the blow, spread over time",
    "effect.Chain.text": "jumps to two more enemies: {m}% and {b}% of the blow",
    "effect.Burn.text": "burns the target ({m}% of the blow) and nearby ones ({b}%)",
    "effect.Weaken.text": "the target deals {m}% less damage to the Tower",
    "effect.Sunder.text": "every {n} hits the target takes +{m}% damage from everyone",
    "effect.Focus.text": "+{m}% damage per consecutive hit on the same target",
    "effect.HuntMark.text": "marks it: the OTHER classes hit it {m}% harder",
    "effect.Bleed.text": "bleed for {m}% of the blow, spread over time",
    "effect.Root.text": "every {n} hits it is held in place for a moment",
    "effect.Seismic.text": "every {n} hits it is pushed half a cell back",
    "effect.Inspire.text": "every {n} attacks, +{m}% attack speed to nearby allies",
    "effect.Loot.text": "if it dies marked, it drops +{m}% gold",
    "effect.Opportunist.text": "+{m}% damage below {n}% health",
    "effect.ThresholdGuard.text": "+{m}% damage against enemies already biting the Tower",
    "effect.ArcaneEcho.text": "every {n} hits, a delayed echo for {m}% of the damage",
    "effect.Overpenetration.text": "on a kill, {m}% of the overkill jumps to the next one",
    "effect.FirstStrike.text": "+{m}% damage above {n}% health",
    "effect.Charge.text": "after a while with no target, the next hit deals +{m}%",
    "effect.Marksman.text": "up to +{m}% damage, the farther the target is",
    "effect.Butchery.text": "up to +{m}% damage, the closer the target is",
    "effect.Bloodthirst.text": "+{m}% damage per kill this wave; resets every wave",
    "effect.TwinStrike.text": "a second strike for {m}% of the damage",
    "effect.Siphon.text": "every so many ticks it heals the Tower for {m}",
    "effect.Perforation.text": "+{m}% per consecutive hit and, on a kill, {b}% of the overkill jumps",
    "effect.FrostWave.text": "hits nearby enemies ({m}% of the blow) and leaves them {b}% slower",
    "effect.WrathOfGod.text": "+{m}% against enemies biting the Tower; every few hits, +{b}% vulnerable",
    "effect.Apocalypse.text": "bleed for {m}% of the blow and +{b}% damage to wounded enemies",
    "effect.TerribleHunger.text": "burns the target ({m}%) and nearby ones ({b}%), and roots it every few hits",
    "effect.DivineStorm.text": "+{m}% attack speed to allies and +{b}% vulnerable on the target",
    "effect.Blindness.text": "+{m}% attack speed to allies; the target deals {b}% less damage",
    "effect.Strength.text": "pushes it back and leaves it +{b}% vulnerable",
    "effect.Invisibility.text": "+{m}% gold if it dies marked and {b}% of the overkill jumps",
