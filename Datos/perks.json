{
  // ---------------------------------------------------------------------------
  //  El catálogo de perks.
  //
  //  LA LÍNEA QUE DIVIDE TODO PASA ENTRE PLATA Y ORO:
  //    bronce, plata  -> NÚMEROS. Cualquier clase, se apilan.
  //    oro, unico     -> COMPORTAMIENTOS. No se apilan.
  //
  //  De ahí sale la regla de apilado sin pensarla perk por perk: "Ricochet dos
  //  veces" no quiere decir nada, "+100 de daño dos veces" sí. Y de ahí sale
  //  también por qué un bronce puede decir 100 y un único 50 sin que esté mal:
  //  no se comparan en el mismo eje.
  //
  //  ⚠ EL JEFE ES LA ÚNICA FUENTE DE ORO. Ocho por corrida.
  //  ⚠ LOS ÚNICOS NO CAEN Y NO SE COMPRAN: SE FUSIONAN (ver planos.json).
  //    Que un único aparezca en una tirada de drop es un bug de datos.
  //
  //  ⚠ Entra al hash de /run/start. Tocar un número acá es TEMPORADA NUEVA.
  // ---------------------------------------------------------------------------
  "version": 1,

  // Cuántas copias del mismo perk entran en una clase. Es la regla de arriba
  // hecha número: apilable si es un número, único si es un comportamiento.
  "maxApiladoPorTier": { "bronce": 3, "plata": 2, "oro": 1, "unico": 1 },

  // ⚠ El "id" se escribe A MANO y no sale de la posición en la lista.
  //
  // La mochila, el log de acciones y las recetas de fusión guardan ids. Si el id
  // fuera posicional, insertar un perk en el medio correría todos los de abajo y
  // una corrida guardada se cargaría con otros perks equipados. Para agregar uno
  // nuevo: usar el próximo id libre y NO reordenar la lista.
  //
  // "efecto" válidos: Dano, Cadencia, Alcance (números) · Ricochet, Splash,
  // Ralentiza, GolpeCritico, Veneno, Penetrante (comportamientos de oro) ·
  // Perforacion, OndaDeFrio, IraDeDios, Apocalipsis, TerribleHambre,
  // TormentaDivina (comportamientos de único).
  //
  // "clases" vacío o ausente = sirve a las nueve.
  // "magnitud" está en puntos porcentuales.
  "perks": [
    // --- Bronce: números chicos, para las nueve clases -----------------------
    { "id":  0, "nombre": "Filo",           "tier": "bronce", "efecto": "Dano",     "magnitud": 15 },
    { "id":  1, "nombre": "Pulso",          "tier": "bronce", "efecto": "Cadencia", "magnitud": 12 },
    { "id":  2, "nombre": "Vista",          "tier": "bronce", "efecto": "Alcance",  "magnitud": 20 },
    { "id":  3, "nombre": "Temple",         "tier": "bronce", "efecto": "Dano",     "magnitud": 10 },
    { "id":  4, "nombre": "Reflejos",       "tier": "bronce", "efecto": "Cadencia", "magnitud":  8 },
    { "id":  5, "nombre": "Puntería",       "tier": "bronce", "efecto": "Alcance",  "magnitud": 15 },
    { "id":  6, "nombre": "Empuñadura",     "tier": "bronce", "efecto": "Dano",     "magnitud": 12 },
    { "id":  7, "nombre": "Muñeca",         "tier": "bronce", "efecto": "Cadencia", "magnitud": 10 },

    // --- Plata: más grandes --------------------------------------------------
    // ⚠ Halcón y Ojo de Águila HOY NO HACEN NADA en las clases de alcance 2
    // (2 × 1,40 = 2,8 → 2 por truncamiento entero). Es la anomalía P0 de la
    // propuesta V2: se arregla escalando el alcance interno ×1000, no subiendo
    // estas magnitudes.
    { "id":  8, "nombre": "Furia",          "tier": "plata",  "efecto": "Dano",     "magnitud": 35 },
    { "id":  9, "nombre": "Celeridad",      "tier": "plata",  "efecto": "Cadencia", "magnitud": 25 },
    { "id": 10, "nombre": "Halcón",         "tier": "plata",  "efecto": "Alcance",  "magnitud": 40 },
    { "id": 11, "nombre": "Saña",           "tier": "plata",  "efecto": "Dano",     "magnitud": 30 },
    { "id": 12, "nombre": "Frenesí",        "tier": "plata",  "efecto": "Cadencia", "magnitud": 22 },
    { "id": 13, "nombre": "Ojo de Águila",  "tier": "plata",  "efecto": "Alcance",  "magnitud": 35 },
    { "id": 14, "nombre": "Ira",            "tier": "plata",  "efecto": "Dano",     "magnitud": 28 },
    { "id": 15, "nombre": "Vendaval",       "tier": "plata",  "efecto": "Cadencia", "magnitud": 20 },

    // --- Oro: comportamiento, compartido por 2-3 clases ----------------------
    // Que un oro sirva para dos o tres clases es lo que hace escribible el
    // catálogo: con todo exclusivo harían falta entre 50 y 90 definiciones.
    //
    // Los parámetros que NO son la magnitud —cuántos rebotes, cuántos
    // secundarios, qué radio— viven en combate.json, agrupados por efecto.
    { "id": 16, "nombre": "Ricochet",          "tier": "oro", "efecto": "Ricochet",     "magnitud":  55, "clases": ["Cazador", "Asesino"] },
    { "id": 17, "nombre": "Onda Expansiva",    "tier": "oro", "efecto": "Splash",       "magnitud":  35, "clases": ["Paladin", "Guerrero", "Mago"] },
    { "id": 18, "nombre": "Escarcha",          "tier": "oro", "efecto": "Ralentiza",    "magnitud":  25, "clases": ["Mago", "Druida", "Clerigo"] },
    { "id": 19, "nombre": "Golpe Certero",     "tier": "oro", "efecto": "GolpeCritico", "magnitud": 125, "clases": ["Asesino", "Ladron", "Cazador"] },
    { "id": 20, "nombre": "Descarga Eléctrica","tier": "oro", "efecto": "Ricochet",     "magnitud":  50, "clases": ["Mago", "Bardo"] },
    { "id": 21, "nombre": "Tormenta de Fuego", "tier": "oro", "efecto": "Splash",       "magnitud":  55, "clases": ["Druida", "Bardo"] },
    { "id": 22, "nombre": "Envenenar",         "tier": "oro", "efecto": "Veneno",       "magnitud":  40, "clases": ["Asesino", "Druida"] },
    { "id": 23, "nombre": "Torpeza",           "tier": "oro", "efecto": "Ralentiza",    "magnitud":  30, "clases": ["Bardo", "Ladron"] },
    { "id": 24, "nombre": "Dardo Mágico",      "tier": "oro", "efecto": "Penetrante",   "magnitud": 120, "clases": ["Mago", "Clerigo"] },
    { "id": 25, "nombre": "Misil Mágico",      "tier": "oro", "efecto": "Splash",       "magnitud":  50, "clases": ["Mago", "Paladin"] },

    // --- Único: NO caen, NO se compran. Se fusionan, y ocupan UN SOLO slot ---
    // El slot liberado es la mitad del premio. Los nombres salen de los 41
    // hechizos reales de Dat\Hechizos.dat de Austral.
    { "id": 26, "nombre": "Perforación",             "tier": "unico", "efecto": "Perforacion",    "magnitud":  90, "clases": ["Cazador"] },
    { "id": 27, "nombre": "Onda de Frío",            "tier": "unico", "efecto": "OndaDeFrio",     "magnitud":  80, "clases": ["Mago"] },
    { "id": 28, "nombre": "Ira de Dios",             "tier": "unico", "efecto": "IraDeDios",      "magnitud": 170, "clases": ["Paladin"] },
    { "id": 29, "nombre": "Apocalipsis",             "tier": "unico", "efecto": "Apocalipsis",    "magnitud":  75, "clases": ["Asesino"] },
    { "id": 30, "nombre": "Terrible Hambre de Igôr", "tier": "unico", "efecto": "TerribleHambre", "magnitud":  55, "clases": ["Druida"] },
    { "id": 31, "nombre": "Tormenta Divina",         "tier": "unico", "efecto": "TormentaDivina", "magnitud":  95, "clases": ["Clerigo"] },
    { "id": 32, "nombre": "Ceguera",                 "tier": "unico", "efecto": "Ralentiza",      "magnitud":  60, "clases": ["Bardo"] },
    { "id": 33, "nombre": "Fuerza",                  "tier": "unico", "efecto": "GolpeCritico",   "magnitud": 260, "clases": ["Guerrero"] },
    { "id": 34, "nombre": "Invisibilidad",           "tier": "unico", "efecto": "Penetrante",     "magnitud": 200, "clases": ["Ladron"] }
  ]
